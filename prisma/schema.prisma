generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlayerRole {
  BATSMAN
  BOWLER
  ALL_ROUNDER
}

enum NoBallReason {
  OVERSTEP
  BACK_FOOT_FAULT
  ILLEGAL_ACTION
  UNDERARM
  BOUNCES_MORE_THAN_ONCE
  ROLLING_BALL
  PITCHED_OFF_PITCH
  BALL_COMES_TO_REST
  BOUNCER_OVER_HEAD
  HIGH_FULL_TOSS
  TOO_MANY_BOUNCERS
  DANGEROUS_BOWLING
  BOWLER_BREAKS_WICKET
  FIELDER_INTERCEPTS_DELIVERY
  WICKET_KEEPER_POSITION
  FIELDING_RESTRICTION
  OTHER
}

enum WideReason {
  OUTSIDE_OFF
  DOWN_LEG
  TOO_FAR_FROM_BATTER
  OTHER
}

enum PenaltyRunReason {
  BALL_HIT_HELMET_ON_GROUND
  FAKE_FIELDING
  DELIBERATE_SHORT_RUN
  BALL_TAMPERING
  TIME_WASTING
  PLAYER_MISCONDUCT
  FIELDING_RESTRICTION
  PITCH_DAMAGE
  OTHER
}

enum DismissalType {
  BOWLED
  CAUGHT
  LBW
  RUN_OUT
  STUMPED
  HIT_WICKET
  HIT_BALL_TWICE
  OBSTRUCTING_FIELD
  TIMED_OUT
  RETIRED_OUT
  RETIRED_HURT
}

enum DeadBallReason {
  OUTSIDE_PERSON_ON_FIELD
  BATTER_DISTRACTED
  PLAYER_INJURY
  BALL_NOT_DELIVERED
  UMPIRE_INTERVENTION
  OTHER
}

enum MatchFormat {
  ODI
  T20
  T10
}

enum MatchStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
  ABANDONED
}

enum TossDecision {
  BAT
  BOWL
}

enum MatchInningNo {
  FIRST
  SECOND
}

enum MatchInningStatus {
  NOT_STARTED
  LIVE
  COMPLETED
}

model Player {
  id          String     @id @default(cuid())
  playerName  String
  displayName String?
  slug        String     @unique
  photoUrl    String?
  role        PlayerRole

  canKeepWickets Boolean @default(false)

  matchPlayers MatchPlayer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([playerName])
  @@index([displayName])
  @@index([role])
  @@map("players")
}

model Team {
  id       String  @id @default(cuid())
  teamName String  @unique
  logoUrl  String?
  slug     String  @unique

  homeMatches       Match[] @relation("HomeTeam")
  awayMatches       Match[] @relation("AwayTeam")
  tossWinnerMatches Match[] @relation("TossWinnerTeam")

  innings      MatchInning[]
  matchPlayers MatchPlayer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("teams")
}

model Match {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  matchFormat MatchFormat
  status      MatchStatus @default(UPCOMING)

  matchDate DateTime

  venue String?
  city  String?

  homeTeamId String
  awayTeamId String

  tossWinnerTeamId String?
  tossDecision     TossDecision?

  homeTeam Team @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam Team @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)

  tossWinnerTeam Team? @relation("TossWinnerTeam", fields: [tossWinnerTeamId], references: [id], onDelete: Restrict)

  innings MatchInning[]
  players MatchPlayer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
  @@index([matchDate])
  @@index([status, matchDate])
  @@index([matchFormat])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([tossWinnerTeamId])
  @@map("matches")
}

model MatchPlayer {
  id String @id @default(cuid())

  matchId  String
  teamId   String
  playerId String

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Restrict)
  player Player @relation(fields: [playerId], references: [id], onDelete: Restrict)

  isPlaying     Boolean @default(false)
  isCaptain     Boolean @default(false)
  isViceCaptain Boolean @default(false)

  // =========================
  // Batting
  // =========================

  didBat Boolean @default(false)

  runsScored Int @default(0)
  ballsFaced Int @default(0)

  battingDotBalls Int @default(0)
  singles         Int @default(0)
  doubles         Int @default(0)
  triples         Int @default(0)
  runningFours    Int @default(0)

  fours Int @default(0)
  sixes Int @default(0)

  isOut         Boolean        @default(false)
  dismissalType DismissalType?

  // =========================
  // Bowling
  // =========================

  didBowl Boolean @default(false)

  legalBallsBowled Int @default(0)

  bowlingDotBalls Int @default(0)

  singlesConceded      Int @default(0)
  doublesConceded      Int @default(0)
  triplesConceded      Int @default(0)
  runningFoursConceded Int @default(0)

  foursConceded Int @default(0)
  sixesConceded Int @default(0)

  wideDeliveries   Int @default(0)
  noBallDeliveries Int @default(0)

  runsConceded Int @default(0)
  maidens      Int @default(0)
  wickets      Int @default(0)

  twoWicketsInTwoBalls   Int @default(0)
  hatTricks              Int @default(0)
  fourWicketsInFourBalls Int @default(0)
  fiveWicketsInFiveBalls Int @default(0)
  sixWicketsInSixBalls   Int @default(0)

  // =========================
  // Fielding
  // =========================

  catches      Int @default(0)
  catchAssists Int @default(0)

  stumpings Int @default(0)

  runOuts       Int @default(0)
  runOutAssists Int @default(0)

  ballsAsStriker       Ball[] @relation("BallStriker")
  ballsAsNonStriker    Ball[] @relation("BallNonStriker")
  ballsAsBowler        Ball[] @relation("BallBowler")
  ballsAsDismissed     Ball[] @relation("BallDismissedPlayer")
  ballsAsFielder       Ball[] @relation("BallFielder")
  ballsAsAssistFielder Ball[] @relation("BallAssistFielder")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, playerId])
  @@index([teamId])
  @@index([playerId])
  @@index([matchId, teamId])
  @@index([matchId, teamId, isPlaying])
  @@map("match_players")
}

model MatchInning {
  id      String @id @default(cuid())
  matchId String
  teamId  String

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Restrict)

  inningsNo MatchInningNo

  runs    Int @default(0)
  wickets Int @default(0)
  balls   Int @default(0)

  maxOvers Int
  status   MatchInningStatus @default(NOT_STARTED)

  // Required only for SECOND innings. Validate in backend.
  target Int?

  ballsData Ball[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, inningsNo])
  @@index([matchId, status])
  @@index([teamId])
  @@map("match_innings")
}

model Ball {
  id String @id @default(cuid())

  inningId String
  inning   MatchInning @relation(fields: [inningId], references: [id], onDelete: Cascade)

  // Every delivery event in this innings.
  // This increases even for wide/no-ball/dead-ball.
  deliveryNo Int

  // Display ball position.
  // Example: overNo = 4, ballNo = 3 means 4.3
  // Wide/no-ball can repeat same overNo + ballNo.
  overNo Int
  ballNo Int

  strikerMatchPlayerId    String
  nonStrikerMatchPlayerId String
  bowlerMatchPlayerId     String

  strikerMatchPlayer    MatchPlayer @relation("BallStriker", fields: [strikerMatchPlayerId], references: [id], onDelete: Restrict)
  nonStrikerMatchPlayer MatchPlayer @relation("BallNonStriker", fields: [nonStrikerMatchPlayerId], references: [id], onDelete: Restrict)
  bowlerMatchPlayer     MatchPlayer @relation("BallBowler", fields: [bowlerMatchPlayerId], references: [id], onDelete: Restrict)

  isLegalDelivery Boolean @default(true)

  isFour   Boolean @default(false)
  isSix    Boolean @default(false)
  isWide   Boolean @default(false)
  isNoBall Boolean @default(false)
  isBye    Boolean @default(false)
  isLegBye Boolean @default(false)

  isPenalty Boolean @default(false)

  isDeadBall     Boolean         @default(false)
  deadBallReason DeadBallReason?

  noBallReasons NoBallReason[] @default([])
  wideReason    WideReason?

  penaltyRunReason PenaltyRunReason?

  batterRuns  Int @default(0)
  noBallRuns  Int @default(0)
  wideRuns    Int @default(0)
  byeRuns     Int @default(0)
  legByeRuns  Int @default(0)
  penaltyRuns Int @default(0)

  extraRuns Int @default(0)
  totalRuns Int @default(0)

  isWicket               Boolean        @default(false)
  dismissalType          DismissalType?
  dismissedMatchPlayerId String?

  dismissedMatchPlayer MatchPlayer? @relation("BallDismissedPlayer", fields: [dismissedMatchPlayerId], references: [id], onDelete: Restrict)

  fielderMatchPlayerId       String?
  assistFielderMatchPlayerId String?

  fielderMatchPlayer       MatchPlayer? @relation("BallFielder", fields: [fielderMatchPlayerId], references: [id], onDelete: Restrict)
  assistFielderMatchPlayer MatchPlayer? @relation("BallAssistFielder", fields: [assistFielderMatchPlayerId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([inningId, deliveryNo])
  @@index([inningId, overNo, ballNo])
  @@index([strikerMatchPlayerId])
  @@index([nonStrikerMatchPlayerId])
  @@index([bowlerMatchPlayerId])
  @@index([dismissedMatchPlayerId])
  @@index([fielderMatchPlayerId])
  @@index([assistFielderMatchPlayerId])
  @@map("balls")
}
